,&apos;SimSun&apos;,&apos;Songti SC&apos;,&apos;STSong&apos;,serif;font-size:14px;font-weight:700;line-height:1.9}&#10;.hand.cat{color:inherit!important;opacity:.85}&#10;.badges{display:flex;flex-wrap:wrap;gap:6px;margin-top:10px}&#10;.badge{font-size:11px;padding:3px 10px;border-radius:20px;background:rgba(127,127,127,.12);font-weight:700}&#10;.badge.hot{background:linear-gradient(90deg,#0f766e,#0ea5a4);color:#fff!important}&#10;.stats{display:flex;margin:16px 0 4px;background:rgba(127,127,127,.08);border-radius:14px;padding:12px 0;text-align:center}&#10;.stat{flex:1;position:relative}&#10;.stat+.stat::before{content:&apos;&apos;;position:absolute;left:0;top:22%;height:56%;width:1px;background:rgba(127,127,127,.25)}&#10;.stat b{display:block;font-size:17px;font-weight:800}&#10;.stat span{font-size:11px;opacity:.6;font-weight:800}&#10;.section{margin-top:14px}&#10;.section h3{font-size:14px;font-weight:800;margin-bottom:7px;display:flex;align-items:center;gap:7px;letter-spacing:1px}&#10;.section h3::before{content:&apos;&apos;;width:4px;height:14px;border-radius:2px;background:linear-gradient(180deg,#0f766e,#0ea5a4)}&#10;.tags{display:flex;flex-wrap:wrap;gap:6px}&#10;.tag{font-size:12px;padding:3px 11px;border-radius:8px;background:rgba(127,127,127,.10);font-weight:700}&#10;.rank{font-size:13px;padding:9px 12px;border-radius:10px;background:rgba(127,127,127,.06);border:1px solid rgba(127,127,127,.22)}&#10;.rank b{font-weight:800}&#10;.intro-text{font-size:14px;line-height:2;text-align:justify;text-indent:2em;font-family:&apos;Noto Serif CJK SC&apos;,&apos;Source Han Serif SC&apos;,&apos;SimSun&apos;,&apos;Songti SC&apos;,&apos;STSong&apos;,serif}&#10;/* 关键信息：灰青突出（作者/评分粉丝值万字/标签/声明四字/二月无雪/24小时内删除） */&#10;.hand,.stat b,.tag,.notice .off,.notice b{color:#0f766e!important}&#10;html.dark .hand,html.dark .stat b,html.dark .tag,html.dark .notice .off,html.dark .notice b{color:#5eead4!important}&#10;.notice .off{opacity:1}&#10;/* 底栏（书源声明）：透明，跟随阅读主题 */&#10;.notice{margin-top:16px;padding:10px 14px;border:1px dashed rgba(127,127,127,.4);border-radius:12px;font-size:12px;text-align:center;line-height:1.8;background:transparent}&#10;.notice .hand{font-size:12.5px}&lt;/style&gt;&#10;&lt;div class="card"&gt;&#10;  &lt;div class="hero"&gt;&#10;    &lt;img class="cover" src="https://static.midureader.com/book/cover/179-22292070000065702.png" onerror="this.style.display=&apos;none&apos;"/&gt;&#10;    &lt;div class="hero-main"&gt;&#10;      &lt;div class="title"&gt;斗罗大陆&lt;/div&gt;&#10;      &lt;div class="row"&gt;&lt;span class="off"&gt;作者&lt;/span&gt;&lt;span class="hand"&gt;唐家三少&lt;/span&gt;&lt;/div&gt;&#10;      &lt;div class="row"&gt;&lt;span class="off"&gt;分类&lt;/span&gt;&lt;span class="hand cat"&gt;玄幻&lt;/span&gt;&lt;/div&gt;&#10;      &lt;div class="badges"&gt;&#10;        &lt;span class="badge"&gt;完结&lt;/span&gt;&#10;        &lt;span class="badge hot"&gt;&#128293; 10.2万 热度&lt;/span&gt;&#10;      &lt;/div&gt;&#10;    &lt;/div&gt;&#10;  &lt;/div&gt;&#10;  &lt;div class="stats"&gt;&#10;    &lt;div class="stat"&gt;&lt;b&gt;9.3&lt;/b&gt;&lt;span&gt;评分&lt;/span&gt;&lt;/div&gt;&#10;    &lt;div class="stat"&gt;&lt;b&gt;1885.43万&lt;/b&gt;&lt;span&gt;粉丝值&lt;/span&gt;&lt;/div&gt;&#10;    &lt;div class="stat"&gt;&lt;b&gt;286.6&lt;/b&gt;&lt;span&gt;万字&lt;/span&gt;&lt;/div&gt;&#10;  &lt;/div&gt;&#10;    &lt;div class="section"&gt;&lt;h3&gt;作品标签&lt;/h3&gt;&lt;div class="tags"&gt;&lt;span class="tag"&gt;穿越流&lt;/span&gt;&lt;span class="tag"&gt;修士&lt;/span&gt;&lt;span class="tag"&gt;武魂&lt;/span&gt;&lt;span class="tag"&gt;魔法&lt;/span&gt;&lt;span class="tag"&gt;斗气&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&#10;    &#10;  &lt;div class="section"&gt;&#10;    &lt;h3&gt;内容简介&lt;/h3&gt;&#10;    &lt;div class="intro-text"&gt;　　唐门外门弟子唐三，因偷学内门绝学为唐门所不容，跳崖明志时却发现没有死，反而以另外一个身份来到了另一个世界，一个属于武魂的世界，名叫斗罗大陆。这里没有魔法，没有斗气，没有武术，却有神奇的武魂。这里的每个人，在自己六岁的时候，都会在武魂殿中令武魂觉醒。武魂有动物，有植物，有器物，武魂可以辅助人们的日常生活。而其中一些特别出色的武魂却可以用来修炼并进行战斗，这个职业，是斗罗大陆上最为强大也是最荣耀的职业——魂师!&#10;　　当唐门暗器来到斗罗大陆，当唐三武魂觉醒，他能否在这片武魂的世界再铸唐门的辉煌？他能否成为这个世界的主宰：神?&lt;/div&gt;&#10;  &lt;/div&gt;&#10;  &lt;div class="notice"&gt;&lt;span class="off"&gt;书源声明&lt;/span&gt;：&lt;span class="hand"&gt;此书源由&lt;b&gt;二月无雪&lt;/b&gt;所制，仅供交流学习，禁止分享与二创，请在使用&lt;b&gt;24小时内删除&lt;/b&gt;，谢谢配合！&lt;/span&gt;&lt;/div&gt;&#10;&lt;/div&gt;&#10;&lt;/useweb&gt;' checkable="false" checked="false" clickable="false" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[48,1911][1032,1920]" drawing-order="0" hint="" /></node></node><node index="1" text="" resource-id="" class="android.widget.ImageView" package="io.legado.flutter_legado" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[0,0][1080,1440]" drawing-order="0" hint="" /><node index="2" text="" resource-id="" class="android.widget.Button" package="io.legado.flutter_legado" content-desc="阅读" checkable="false" checked="false" clickable="true" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[743,1704][1032,1872]" drawing-order="0" hint="" /></node></node></node></node></node></node></node></node></hierarchy>