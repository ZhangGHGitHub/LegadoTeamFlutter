r="4" hint="" /><node index="5" text="，，。 方夕意外撞了大运，得一卷百世书，从此无尽轮回。 第一世，他默默无闻，为了保护家人，葬身妖腹； 第二世，他隐于山门，静心锻器，千锤百炼铸就道基； 第三世，他持剑踏血，背负血海深仇，一剑横空斩灭世间仇敌； 第四世，他登九五帝位，执掌万里江山，运筹权谋定天下沉浮。 炼万法剑元，悟无上剑意，以百世积淀，踏破仙门大关。 纵然前路劫数重重，我自携百世沧桑，一剑叩开仙门！ （本书世界观参考紫府金丹道改编，节奏偏稳，重修炼、斗法与人物成长。）" resource-id="" class="android.widget.TextView" package="io.legato.kazusa" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[288,1890][1032,1920]" drawing-order="5" hint="" /></node></node></node><node index="1" text="" resource-id="" class="android.view.View" package="io.legato.kazusa" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[468,192][612,336]" drawing-order="1" hint=""><node index="0" text="" resource-id="" class="android.view.View" package="io.legato.kazusa" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[468,192][612,336]" drawing-order="0" hint=""><node index="0" text="" resource-id="" class="android.widget.ProgressBar" package="io.legato.kazusa" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[468,192][612,336]" drawing-order="0" hint="" /></node></node><node index="2" text="" resource-id="" class="android.view.View" package="io.legato.kazusa" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[0,0][1080,336]" drawing-order="2" hint=""><node index="0" 