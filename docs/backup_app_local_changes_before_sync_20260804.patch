+    /**
+     * 关联 ID 失败诊断：与 [put] 共用内存环形缓冲，消息携带 [correlationId]，
+     * 便于把 触发 → 边界/决策 → 失败/恢复 → 结果 链关联起来；
+     * 当 [AppConfig.recordLog] 开启时追加写入 filesDir/logs/js-source.log（默认关闭，行为与现有日志一致）。
+     */
+    fun putCorrelated(
+        correlationId: String,
+        message: String?,
+        throwable: Throwable? = null,
+    ) {
+        put("[$correlationId] $message", throwable)
+        if (AppConfig.recordLog) {
+            try {
+                val logFile = File(appCtx.filesDir, "logs/js-source.log")
+                logFile.parentFile?.mkdirs()
+                logFile.appendText(
+                    "[${System.currentTimeMillis()}] [$correlationId] $message"
+                        + (throwable?.let { "\n${it.stackTraceToString()}" } ?: "") + "\n"
+                )
+            } catch (_: Exception) {
+                // 持久化失败不影响主流程
+            }
+        }
+    }
+
 }
