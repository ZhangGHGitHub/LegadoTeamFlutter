<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- 允许本地调试时的 HTTP 流量 -->
    <debug-overrides>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </debug-overrides>
    <!-- 默认允许明文 HTTP（书源多为 HTTP） -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
